{
  "$schema": "https://opencode.ai/config.json",
  "username": "ming",
  "default_agent": "general",
  "shell": "/bin/bash",
  "logLevel": "INFO",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["WORKFLOW.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "references": {
    "workflow": {
      "path": ".",
      "description": "Forge development workflow documentation"
    }
  },
  "agent": {
    "forge-workflow": {
      "description": "Assistant for managing Forge development workflow and sync processes",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "ask",
        "bash": "allow"
      }
    }
  }
}